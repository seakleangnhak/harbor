# Fresh installs only. Keep existing .env, volume, key and session when upgrading.
# Copy to .env, run chmod 600 .env, then generate a private setup token:
# openssl rand -hex 32
# Paste output below; .env does not execute shell commands.
DRIVE_SETUP_TOKEN=

# Required for HTTPS / Dokploy; leave commented for localhost HTTP.
# DRIVE_SECURE_COOKIES=true

# Optional Compose host port; default 8080.
# DRIVE_PORT=8080

# Create owner password and configure Telegram in the browser.
# Full configuration and existing-drive setup: README.md and docs/WEB_ONBOARDING.md.
