# Configuration reference. Go loads private .env; process environment takes priority.
# chmod 600 .env; DRIVE_ENV_FILE=- disables loading for isolated tests.
DRIVE_ADDR=127.0.0.1:8080
DRIVE_DATA_DIR=./data
# Leave empty for browser storage selection. Existing drives keep their adapter.
DRIVE_STORAGE=
# Fresh installations require a random bootstrap token (32–256 characters).
# Generate with: openssl rand -hex 32
# DRIVE_SETUP_TOKEN=
DRIVE_STATIC_DIR=./web/dist
DRIVE_SECURE_COOKIES=false
# Host default is loopback. Explicit opt-in only for a trusted internal HTTP listener.
# Compose opts in inside container while publishing host port on loopback.
DRIVE_ALLOW_REMOTE_HTTP=false
# Compose host port; Go binary uses DRIVE_ADDR instead.
DRIVE_PORT=8080
# DRIVE_OWNER_PASSWORD_FILE=./data/owner-password
# DRIVE_KEY_FILE=./data/content.key
# Telegram build: go build -tags telegram -o bin/drive ./cmd/drive
# Dedicated account credentials stay server-side. Never prefix secrets with VITE_.
# TELEGRAM_APP_ID=
# TELEGRAM_APP_HASH=
# TELEGRAM_SESSION_FILE=./data/telegram.session
# Owned private channel only; public usernames are rejected.
# USERNAME_OR_CHANNEL_LINK=https://t.me/+YOUR_PRIVATE_INVITE
# Optional channel ID checks the link target (positive MTProto or Bot API format).
# TELEGRAM_CHANNEL_ID=
# Legacy numeric-only configuration also requires this hash; omit when using a link.
# TELEGRAM_CHANNEL_ACCESS_HASH=

# Data directories must be mode 0700; key/password/session files mode 0600.
# Web setup config/session/password live under <data>/setup and backup auto-detects them.
# Legacy Telegram backup requires explicit --config-file for actual runtime adapter.
# Backup password belongs in a separate private file or hidden Terminal prompt, never here.
